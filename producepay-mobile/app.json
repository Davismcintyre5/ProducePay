{
  "expo": {
    "name": "ProducePay",
    "slug": "producepaymobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "producepay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1b5e20"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.producepay.mobile"
    },
    "android": {
      "package": "com.producepay.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1b5e20"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "507e42a3-b1df-4e62-9070-29e7896f4106"
      }
    }
  }
}
